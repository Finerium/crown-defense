# Crown Defense, environment template. Copy to .env and fill. NEVER commit the real .env.
# 12-factor: all config env-driven (AC-CONFIG). The dial default + detection thresholds are config, not literals.

# --- Data stores (ADR-013: the two stores are kept separate) ---
OPERATIONAL_DB_URL=postgresql://crowndefense:crowndefense@localhost:5432/crowndefense_operational
AUDIT_DB_URL=postgresql://crowndefense:crowndefense@localhost:5432/crowndefense_audit

# --- Signing secrets (generate each with: openssl rand -hex 32) ---
CONTROL_PLANE_TOKEN_SECRET=replace-me-openssl-rand-hex-32
# HMAC key that seals every audit record into the hash chain. It MUST be set in any deployment where the
# chain is written and verified by different processes: on Vercel the telemetry stream that seals a record
# and the /api/audit/* route that verifies it are separate Function invocations, and the per-process random
# key the code falls back to would make a shared chain unverifiable. It is a secret: never logged, never
# returned by a route, never committed. Rotating it invalidates every chain sealed with the old key.
AUDIT_INTEGRITY_KEY=replace-me-openssl-rand-hex-32

# --- LLM (DEV/TEST ONLY, never the production answer; ADR-002 mandates self-hosted on-prem in production) ---
# DeepSeek is OpenAI-API-compatible. The model-agnostic abstraction makes the prod swap a config change.
DEEPSEEK_API_KEY=sk-replace-me
# Orchestration is slow on a reasoning model: measured 51 to 64 seconds per single attempt against
# deepseek-v4-pro with topK 8. Keep timeout * (1 + retries) inside the calling route's maxDuration.
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=1
LLM_API_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# --- Autonomy (shipped + pilot default is MONITOR_ONLY; full-auto is never the default) ---
CROWN_DIAL_DEFAULT=MONITOR_ONLY

# --- Detection thresholds (@crown/detection config.ts ENV_KEYS, names verified by a drift test) ---
# SAFETY: CROWN_DET_MIN_CORROBORATION is clamped to >=2 and CROWN_DET_WINDOW to >=1 (cannot be weakened).
CROWN_DET_ENTROPY_DELTA=1.5
CROWN_DET_ENTROPY_LOW_BASE=6.0
CROWN_DET_ENTROPY_HIGH=7.5
CROWN_DET_OPFREQ_WRITES=50
CROWN_DET_OPFREQ_RENAMES=20
CROWN_DET_OPFREQ_CUMULATIVE=8
CROWN_DET_FORMAT_FAIL_MIN=2
CROWN_DET_TYPE_HEADER_MIN=2
CROWN_DET_ENTROPY_MIN=2
CROWN_DET_WINDOW=256
CROWN_DET_MIN_CORROBORATION=2
CROWN_DET_MAX_HOSTS=5000
# Comma-separated process paths whose IN-PLACE encryption is authorized (AC-FP-02). Empty by default.
CROWN_DET_ALLOWLIST=

# --- Containment time-box (seconds) for human-gated destructive actions ---
CROWN_ACTION_ROLLBACK_SECONDS=300

# --- Demo console (/konsol) auth. DENY BY DEFAULT: with either of these unset, nobody can sign in. ---
# HMAC key that signs the session cookie. Unset => no session is issued and none is accepted.
KONSOL_SECRET=replace-me-openssl-rand-hex-32
# JSON array of operator accounts. Mint one entry per operator with:
#   node scripts/konsol-hash.mjs <email> <label> <password>
# The script prints only the JSON line; it never prints the password. Unset or unparseable => nobody signs in.
KONSOL_USERS=[{"email":"operator@example.test","label":"OPR-00","salt":"replace-me","hash":"replace-me"}]

# --- Rate limits (fixed window, in-memory). Real money is at stake: the LLM key spend is live. ---
KONSOL_LOGIN_MAX=5
KONSOL_LOGIN_WINDOW_MS=300000
KONSOL_RUN_MAX=6
KONSOL_RUN_WINDOW_MS=300000
KONSOL_RUN_GLOBAL_MAX=40
KONSOL_RUN_GLOBAL_WINDOW_MS=3600000
ANALYZE_MAX=4
ANALYZE_WINDOW_MS=600000
ANALYZE_GLOBAL_MAX=25
ANALYZE_GLOBAL_WINDOW_MS=3600000

# --- Demo pacing. Delivery speed only: the telemetry, signals and verdicts are never altered. ---
# Target wall-clock length of one scenario run, then the per-tick gap clamp.
CROWN_DEMO_RUN_WINDOW_MS=7000
CROWN_DEMO_TICK_MIN_MS=60
CROWN_DEMO_TICK_MAX_MS=900
# Idle heartbeat cadence and pending-workload poll interval on GET /api/telemetri/aliran.
TELEMETRI_HEARTBEAT_MS=2000
# Each poll reads the shared run state, which is a Runtime Cache round trip on Vercel. Low enough that a
# console button press shows up on the dashboard almost at once, high enough not to hammer the cache.
TELEMETRI_POLL_MS=750
